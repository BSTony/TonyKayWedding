{
  "rules": {
    "players": {
      ".indexOn": ["points", "lastSeen", "createdAt"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ($uid === auth.uid || $uid === 'google_' + auth.uid || !$uid.beginsWith('google_'))"
      }
    },
    "rankedQueue": {
      ".indexOn": ["createdAt", "status"],
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null"
      }
    },
    "rankedRooms": {
      ".indexOn": ["createdAt", "status"],
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null"
      }
    },
    "tournamentRoom": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "gameState": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "serverInfo": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
